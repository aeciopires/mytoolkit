    {
      "type": "timeseries",
      "title": "p95 latency by tool (duration_ms)",
      "description": "Computed from the duration_ms field of each request log line.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service=~\"mytoolkit.*\", tool=~\"$tool\"} |= \"request completed\" | json | unwrap duration_ms [$__auto]) by (tool)",
          "legendFormat": "{{tool}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
