{
  "id": null,
  "uid": "mytoolkit-logs",
  "title": "MyToolkit — Logs",
  "description": "Structured JSON logs of every container in the Compose project, shipped by Grafana Alloy to Loki (labels: service, container, level, tool; structured metadata: trace_id, span_id). Log lines link to their traces in Tempo.",
  "tags": [
    "mytoolkit",
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "MyToolkit dashboards",
      "type": "dashboards",
      "tags": [
        "mytoolkit"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Explore traces (Tempo)",
      "type": "link",
      "icon": "bolt",
      "keepTime": true,
      "targetBlank": true,
      "url": "/a/grafana-exploretraces-app/explore"
    },
    {
      "title": "Explore logs (Loki)",
      "type": "link",
      "icon": "doc",
      "keepTime": true,
      "targetBlank": true,
      "url": "/a/grafana-lokiexplore-app/explore"
    },
    {
      "title": "Jaeger UI",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "http://localhost:16686/search?service=mytoolkit"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "mytoolkit",
            "mytoolkit-mcp"
          ],
          "value": [
            "mytoolkit",
            "mytoolkit-mcp"
          ]
        },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug,fatal",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tool",
        "label": "Tool",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "tool",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(tool)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "search",
        "label": "Search (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Log lines (selected range)",
      "description": "All log lines matching the filters above.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"$service\", level=~\"$level\", tool=~\"$tool\"} |~ \"$search\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
