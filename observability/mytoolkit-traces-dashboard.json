      },
      "description": "REST 'tool <slug>' spans and MCP 'mcp tools/call <tool>' spans.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && span.mytoolkit.tool != nil}",
