# Interface the HTTP server binds to.
MYTOOLKIT_HOST=0.0.0.0

# TCP port the HTTP server listens on.
MYTOOLKIT_PORT=8080

# Log level: debug, info, warn, error. Logs are always JSON on stderr.
MYTOOLKIT_LOG_LEVEL=info

# MCP server transport: stdio or http. Only used by `mytoolkit mcp`.
MYTOOLKIT_MCP_TRANSPORT=stdio

# TCP port `mytoolkit mcp --transport http` listens on.
MYTOOLKIT_MCP_PORT=8081

# After SIGTERM, keep serving this long with /readyz returning 503 before
# closing the listener (Go duration, e.g. 5s). Default: no delay.
# MYTOOLKIT_SHUTDOWN_DELAY=5s

# OpenTelemetry tracing (OTLP/HTTP) — unset means tracing is off.
# docker-compose.yml already points both app services at Grafana Alloy.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
